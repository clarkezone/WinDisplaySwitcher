<Window
    x:Class="DisplaySwitcher.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DisplaySwitcher Settings">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Resolution Profiles" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
            <Button x:Name="AddProfileBtn" Content="+ Add Profile"/>
        </StackPanel>

        <!-- Profile list -->
        <ListView x:Name="ProfileList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding HotkeyDisplay}" VerticalAlignment="Center" Foreground="Gray"/>
                        <Button Grid.Column="2" Content="Set Hotkey" Tag="{Binding}" Click="OnSetHotkeyClick"/>
                        <Button Grid.Column="3" Content="Clear" Tag="{Binding}" Click="OnClearHotkeyClick"/>
                        <Button Grid.Column="4" Content="Remove" Tag="{Binding}" Click="OnRemoveClick"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Add profile panel -->
        <StackPanel x:Name="AddPanel" Grid.Row="2" Visibility="Collapsed" Spacing="8" Padding="0,8">
            <ComboBox x:Name="MonitorCombo" Header="Monitor" HorizontalAlignment="Stretch"/>
            <ComboBox x:Name="ResolutionCombo" Header="Resolution" HorizontalAlignment="Stretch"/>
            <ComboBox x:Name="ScaleCombo" Header="Scale %" HorizontalAlignment="Stretch"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ConfirmAddBtn" Content="Add"/>
                <Button x:Name="CancelAddBtn" Content="Cancel"/>
            </StackPanel>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" Padding="0,12,0,0">
            <ToggleSwitch x:Name="AutoStartToggle" Header="Start with Windows"/>
        </StackPanel>
    </Grid>
</Window>
