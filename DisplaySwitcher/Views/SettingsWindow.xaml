<Window
    x:Class="DisplaySwitcher.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DisplaySwitcher Settings">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Display Profiles" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
            <Button x:Name="AddProfileBtn" Content="+ Add Profile"/>
        </StackPanel>

        <!-- Profile list -->
        <ListView x:Name="ProfileList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding HotkeyDisplay}" VerticalAlignment="Center" Foreground="Gray"/>
                        <Button Grid.Column="2" Content="Set Hotkey" Tag="{Binding}" Click="OnSetHotkeyClick"/>
                        <Button Grid.Column="3" Content="Clear Hotkey" Tag="{Binding}" Click="OnClearHotkeyClick"/>
                        <Button Grid.Column="4" Content="Edit" Tag="{Binding}" Click="OnEditClick"/>
                        <Button Grid.Column="5" Content="Remove" Tag="{Binding}" Click="OnRemoveClick"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Add/Edit profile panel -->
        <ScrollViewer x:Name="AddPanel" Grid.Row="2" Visibility="Collapsed" MaxHeight="450" Padding="0,8">
            <StackPanel Spacing="8">
                <TextBox x:Name="ProfileNameBox" Header="Profile Name" PlaceholderText="e.g. Work Dual, Gaming, etc."/>
                <ComboBox x:Name="TopologyCombo" Header="Display Topology" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Monitor Settings" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>
                <TextBlock Text="Each monitor entry is optional. Leave resolution/scale as 'Don't change' to skip."
                           Foreground="Gray" TextWrapping="Wrap"/>

                <!-- Per-monitor entries container -->
                <StackPanel x:Name="MonitorEntriesPanel" Spacing="12"/>

                <Button x:Name="AddMonitorEntryBtn" Content="+ Add Monitor" Click="OnAddMonitorEntry"/>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="ConfirmAddBtn" Content="Save"/>
                    <Button x:Name="CancelAddBtn" Content="Cancel"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" Padding="0,12,0,0">
            <ToggleSwitch x:Name="AutoStartToggle" Header="Start with Windows"/>
        </StackPanel>
    </Grid>
</Window>
